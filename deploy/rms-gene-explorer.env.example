# Configuration for rms-gene-explorer.service.
# Install to /etc/rms-gene-explorer.env and edit APP_DIR.
#
#   sudo install -m 0644 deploy/rms-gene-explorer.env.example /etc/rms-gene-explorer.env
#
# systemd does NOT expand $HOME, ~, or run a shell over this file — every value must be a
# literal. Replace the username below with the account that owns the checkout.
APP_DIR=/home/jennysmith/github_repos/2026-09-25_RNAseq_RMS_targets

# Published image. Pull with `docker pull ghcr.io/meshinchi-lab/rms-gene-explorer:4.5.3`,
# or build locally from the repo Dockerfile and set this to `rms-gene-explorer:4.5.3`.
IMAGE=ghcr.io/meshinchi-lab/rms-gene-explorer:4.5.3

# Port on the HOST. The container always listens on 3838 internally.
PORT=3838

# Bind address on the host.
#
# 127.0.0.1 keeps the app reachable only from the server itself, so users connect over an
# SSH tunnel:
#
#     ssh -N -L 3838:127.0.0.1:3838 YOUR_USER@REMOTE_HOST
#
# This is the correct default: PCGP is controlled-access under dbGaP phs000720 and the
# OPBG cohort is pre-publication. Setting 0.0.0.0 publishes sample-level expression to
# every host that can route to this machine — only do that behind institutional SSO or a
# firewall that you have confirmed, and check it against the DUA first.
BIND_ADDR=127.0.0.1

# Ceiling for the container. DuckDB is configured for a 4 GB limit inside the app, and
# arrow plus the two in-memory index tables add roughly 1 GB; 8 GB leaves headroom for
# several concurrent sessions.
MEM_LIMIT=8g
